# Root .env is read by Docker Compose. Keep real values out of Git.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://<db-host>:<db-port>/postgres?sslmode=require
DB_USERNAME=<db-username>
DB_PASSWORD=<db-password>
# For supabase profile, use your project's Auth URL and its asymmetric signing-key JWKS.
SUPABASE_JWT_ISSUER_URI=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_JWK_SET_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
FINSIGHT_ALLOWED_ORIGINS=http://localhost:5173,http://10.0.2.2:8080
